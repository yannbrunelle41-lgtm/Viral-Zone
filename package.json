{
  "name": "appli-roussel",
  "version": "1.0.0",
  "private": true,
  "description": "Application interactive Fleurs Roussel (brief IA collectif)",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "serve": "http-server -c-1 -p 8080"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
